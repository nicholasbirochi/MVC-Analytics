{
    "files.exclude": {
        ".git": true,
        ".venv": true,
        "venv": true,
        "__pycache__": true,
        "**/__pycache__": true,
        "**/__init__.py": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/*.log": true,
        ".DS_Store": true
    },
    "editor.fontSize": 12,
    "editor.tabSize": 4,
    "editor.minimap.sectionHeaderFontSize": 9,
    "terminal.integrated.fontSize": 16,
    "screencastMode.fontSize": 56,
    "scm.inputFontSize": 13,
    "workbench.localHistory.mergeWindow": 10
}
