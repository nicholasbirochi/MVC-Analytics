# Canonical data source (required for notebook-equivalent MVC output)
RONDA_DW_PATH=../_dados_ronda_local/project/database/dw_ronda.sqlite

# Optional local-only sources (keep outside the repository)
RONDA_LOGIN_DB_PATH=../_dados_ronda_local/project/database/db_login.sqlite
RONDA_RAW_DATA_DIR=../_dados_ronda_local/Base de Dados Original

# Legacy fallback (parquet mode) - optional
# ND_DATA_DIR=../_dados_ronda_local/project/database

# Runtime
ND_PANDAS_LOCALE=pt_BR.utf8
ND_CACHE_TTL=900
ND_DEBUG=false
ND_PORT=8050

# Optional filters
# AREAS_FORA=B-SNP,B-V
