# Fonte canonica do DW SQLite. Use caminho local fora do repositorio.
RONDA_DW_PATH=changeme

# Banco de login local. Opcional; nao versione o arquivo real.
RONDA_LOGIN_DB_PATH=changeme

# Pasta local com dados brutos. Opcional; mantenha fora do repositorio.
RONDA_RAW_DATA_DIR=changeme

# Runtime do dashboard
ND_PANDAS_LOCALE=pt_BR.utf8
ND_CACHE_TTL=900
ND_DEBUG=false
ND_PORT=8050

# Consulta Pessoal. Preencha somente no ambiente local/seguro.
CONSULTA_PESSOAL_BASE_URL=changeme
CONSULTA_PESSOAL_URL=changeme
CONSULTA_PESSOAL_ORIGIN=changeme
CONSULTA_PESSOAL_USER=changeme
CONSULTA_PESSOAL_PASSWORD=changeme
CONSULTA_PESSOAL_BASE_DIR=changeme
CONSULTA_PESSOAL_EXECUTABLE=changeme
